/** @Validation.Testing.Predicates — queries structured validation results */
module PuduLangValidator.Testing

import Std.List as List
import PuduLangValidator.Async as Async
import PuduLangValidator.Result as Validation
import PuduLangValidator.Validator as Validator

/** @Validation.Testing.FailureQuery — narrows failures while retaining the full result */
export type FailureQuery = {
  all: Array[Validation.Failure],
  matched: Array[Validation.Failure]
}

/// Run a validator and inspect its ordinary result.
export fn testValidate[T](validator: &Validator.Validator[T], root: T) -> Validation.ValidationResult {
  Validator.validate(validator, root)
}

/// Run selected rules and inspect their ordinary result.
export fn testValidateWith[T](
  validator: &Validator.Validator[T], root: T, options: Validator.Options
) -> Validation.ValidationResult {
  Validator.validateWith(validator, root, options)
}

/// Await a validator and inspect its ordinary result.
export async fn testValidateAsync[T](
  validator: &Async.AsyncValidator[T], root: T
) -> Validation.ValidationResult {
  Async.validateAsync(validator, root).await
}

/// Await selected rules and inspect their ordinary result.
export async fn testValidateAsyncWith[T](
  validator: &Async.AsyncValidator[T], root: T, options: Validator.Options
) -> Validation.ValidationResult {
  Async.validateAsyncWith(validator, root, options).await
}

/// Select failures at one exact property path, including collection indices.
export fn forProperty(result: &Validation.ValidationResult, path: Str) -> FailureQuery {
  FailureQuery{all: result.errors,
    matched: result.errors.filter(|failure: Validation.Failure| failure.propertyName == path) }
}

/// Retain failures whose full message matches the given text.
export fn withMessage(query: FailureQuery, message: Str) -> FailureQuery {
  FailureQuery{..query, matched: query.matched.filter(|failure: Validation.Failure| failure.errorMessage == message)}
}

/// Retain failures whose message differs from the given text.
export fn withoutMessage(query: FailureQuery, message: Str) -> FailureQuery {
  FailureQuery{..query, matched: query.matched.filter(|failure: Validation.Failure| failure.errorMessage != message)}
}

/// Retain failures carrying the given error code.
export fn withCode(query: FailureQuery, code: Str) -> FailureQuery {
  FailureQuery{..query, matched: query.matched.filter(|failure: Validation.Failure| failure.errorCode == code)}
}

/// Retain failures carrying another error code.
export fn withoutCode(query: FailureQuery, code: Str) -> FailureQuery {
  FailureQuery{..query, matched: query.matched.filter(|failure: Validation.Failure| failure.errorCode != code)}
}

/// Retain failures at the given severity.
export fn withSeverity(query: FailureQuery, severity: Validation.Severity) -> FailureQuery {
  FailureQuery{..query, matched: query.matched.filter(|failure: Validation.Failure| failure.severity == severity)}
}

/// Retain failures at another severity.
export fn withoutSeverity(query: FailureQuery, severity: Validation.Severity) -> FailureQuery {
  FailureQuery{..query, matched: query.matched.filter(|failure: Validation.Failure| failure.severity != severity)}
}

/// Retain failures with the given application state.
export fn withState(query: FailureQuery, state: Str) -> FailureQuery {
  FailureQuery{..query, matched: query.matched.filter(|failure: Validation.Failure| failure.customState == state)}
}

/// Retain failures with another application state.
export fn withoutState(query: FailureQuery, state: Str) -> FailureQuery {
  FailureQuery{..query, matched: query.matched.filter(|failure: Validation.Failure| failure.customState != state)}
}

/// Whether the query retains at least one failure.
export fn hasAny(query: &FailureQuery) -> Bool { !query.matched.isEmpty() }

/// Whether the query retains no failures.
export fn hasNone(query: &FailureQuery) -> Bool { query.matched.isEmpty() }

/// Whether the query retains every failure and at least one exists.
export fn only(query: &FailureQuery) -> Bool {
  !query.matched.isEmpty() && query.matched.length() == query.all.length()
}

/// Whether a result reports a failure at this exact path.
export fn hasErrorFor(result: &Validation.ValidationResult, path: Str) -> Bool {
  List.any(&result.errors, |failure: Validation.Failure| failure.propertyName == path)
}

/// Whether a result reports no failure at this exact path.
export fn hasNoErrorFor(result: &Validation.ValidationResult, path: Str) -> Bool {
  !hasErrorFor(result, path)
}

/// Whether any failure has the stable error code.
export fn hasCode(result: &Validation.ValidationResult, code: Str) -> Bool {
  List.any(&result.errors, |failure: Validation.Failure| failure.errorCode == code)
}

/// Whether every failure is confined to the named paths, with at least one failure.
export fn onlyErrorsFor(result: &Validation.ValidationResult, paths: Array[Str]) -> Bool {
  !result.errors.isEmpty() && List.all(&result.errors,
    |failure: Validation.Failure| paths.contains(failure.propertyName))
}
