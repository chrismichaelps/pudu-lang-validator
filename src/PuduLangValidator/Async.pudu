/** @Validation.Async.Engine — awaits typed validation checks */
module PuduLangValidator.Async

import Std.List as List
import PuduLangValidator.Result as Validation
import PuduLangValidator.Rule as Rule
import PuduLangValidator.Validator as Validator

/** @Validation.Async.Rule — owns one asynchronous source check */
export type AsyncRule[T] = {
  name: Str,
  ruleSets: Array[Str],
  run: async fn(T, Validator.Options, Rule.ContextData) -> Array[Validation.Failure]
}

/** @Validation.Async.Validator — orders asynchronous and lifted rules */
export type AsyncValidator[T] = { rules: Array[AsyncRule[T]], stop: Bool }

/// Build an asynchronous check for a typed property.
export fn mustAsync[T, V](
  name: Str, select: fn(T) -> V, test: async fn(T, V) -> Bool,
  message: Str, code: Str
) -> AsyncRule[T] {
  mustAsyncWithContext(name, select,
    async fn(root: T, value: V, _data: Rule.ContextData) -> Bool { test(root, value).await },
    message, code)
}

/// Build an awaited property check that may read immutable root data.
export fn mustAsyncWithContext[T, V](
  name: Str, select: fn(T) -> V, test: async fn(T, V, Rule.ContextData) -> Bool,
  message: Str, code: Str
) -> AsyncRule[T] {
  AsyncRule{name: name, ruleSets: [], run: async fn(root: T, options: Validator.Options, data: Rule.ContextData) -> Array[Validation.Failure] {
      if !options.properties.isEmpty() && !List.any(&options.properties, |wanted: Str|
        wanted == name || name.startsWith(wanted + ".") || name.startsWith(wanted + "[")) { return [] }
      let value = select(root)
      if test(root, value, data).await { [] } else { [Validation.Failure {
            propertyName: name,
            errorMessage: message.replace("\{PropertyName\}", name)
              .replace("\{PropertyPath\}", name)
              .replace("\{PropertyValue\}", value.toText()),
            errorCode: code, severity: Validation.Error, customState: ""
          }] }
    } }
}

/// Check every array element asynchronously in source order.
export fn forEachAsync[T, V](
  name: Str, select: fn(T) -> Array[V], test: async fn(T, V) -> Bool,
  message: Str, code: Str
) -> AsyncRule[T] {
  forEachWhereAsync(name, select, async fn(_item: V) -> Bool { true }, test, message, code)
}

/// Await a filter and check for each selected array element.
export fn forEachWhereAsync[T, V](
  name: Str, select: fn(T) -> Array[V], keep: async fn(V) -> Bool,
  test: async fn(T, V) -> Bool, message: Str, code: Str
) -> AsyncRule[T] {
  forEachWhereAsyncWithContext(name, select,
    async fn(item: V, _data: Rule.ContextData) -> Bool { keep(item).await },
    async fn(root: T, item: V, _data: Rule.ContextData) -> Bool { test(root, item).await },
    message, code)
}

/// Await a context-aware filter and predicate for each selected item.
export fn forEachWhereAsyncWithContext[T, V](
  name: Str, select: fn(T) -> Array[V], keep: async fn(V, Rule.ContextData) -> Bool,
  test: async fn(T, V, Rule.ContextData) -> Bool, message: Str, code: Str
) -> AsyncRule[T] {
  AsyncRule{name: name, ruleSets: [], run: async fn(root: T, options: Validator.Options, data: Rule.ContextData) -> Array[Validation.Failure] {
      var failures: Array[Validation.Failure] = []
      var index = 0
      for item in select(root) {
        let path = name + "[" + show(index) + "]"
        if selectedElement(name, path, &options.properties) && keep(item, data).await && !test(root, item, data).await {
          failures = failures.push(Validation.Failure {
              propertyName: path,
              errorMessage: message.replace("\{PropertyName\}", name)
                .replace("\{PropertyPath\}", path)
                .replace("\{CollectionIndex\}", show(index)),
              errorCode: code, severity: Validation.Error, customState: ""
            })
        }
        index = index + 1
      }
      failures
    } }
}

/// Lift a synchronous rule into an async validator.
export fn fromSync[T](rule: Rule.Rule[T]) -> AsyncRule[T] {
  let name = rule.name
  let sets = rule.ruleSets
  AsyncRule{name: name, ruleSets: sets, run: async fn(root: T, options: Validator.Options, data: Rule.ContextData) -> Array[Validation.Failure] {
      rule.run(root, options.ruleSets, options.includeDefault, options.properties, data)
    } }
}

/// Run this asynchronous rule in a named rule set.
export fn inRuleSet[T](rule: AsyncRule[T], name: Str) -> AsyncRule[T] {
  if rule.ruleSets.contains(name) { rule } else { AsyncRule{..rule, ruleSets: rule.ruleSets.push(name)} }
}

/// Classify every failure from this asynchronous rule.
export fn withSeverity[T](rule: AsyncRule[T], severity: Validation.Severity) -> AsyncRule[T] {
  let name = rule.name
  let sets = rule.ruleSets
  AsyncRule{name: name, ruleSets: sets, run: async fn(root: T, options: Validator.Options, data: Rule.ContextData) -> Array[Validation.Failure] {
      rule.run(root, options, data).await.map(|failure: Validation.Failure| Validation.Failure{..failure, severity: severity})
    } }
}

/// Attach application state to every failure from this rule.
export fn withState[T](rule: AsyncRule[T], state: Str) -> AsyncRule[T] {
  let name = rule.name
  let sets = rule.ruleSets
  AsyncRule{name: name, ruleSets: sets, run: async fn(root: T, options: Validator.Options, data: Rule.ContextData) -> Array[Validation.Failure] {
      rule.run(root, options, data).await.map(|failure: Validation.Failure| Validation.Failure{..failure, customState: state})
    } }
}

/// Run an asynchronous rule only when the source condition holds.
export fn when[T](rule: AsyncRule[T], condition: fn(T) -> Bool) -> AsyncRule[T] {
  let name = rule.name
  let sets = rule.ruleSets
  AsyncRule{name: name, ruleSets: sets, run: async fn(root: T, options: Validator.Options, data: Rule.ContextData) -> Array[Validation.Failure] {
      if condition(root) { rule.run(root, options, data).await } else { [] }
    } }
}

/// A validator with no asynchronous rules.
export fn create[T]() -> AsyncValidator[T] { AsyncValidator{rules: [], stop: false} }

/// Append an asynchronous rule in execution order.
export fn add[T](validator: AsyncValidator[T], rule: AsyncRule[T]) -> AsyncValidator[T] {
  AsyncValidator{..validator, rules: validator.rules.push(rule)}
}

/// Stop after the first asynchronous rule that reports failures.
export fn stopOnFirst[T](validator: AsyncValidator[T]) -> AsyncValidator[T] {
  AsyncValidator{..validator, stop: true}
}

/// Await unnamed rules in declaration order and collect failures.
export async fn validateAsync[T](validator: &AsyncValidator[T], root: T) -> Validation.ValidationResult {
  validateAsyncWith(validator, root, Validator.defaults()).await
}

/// Await selected rules in declaration order and collect failures.
export async fn validateAsyncWith[T](
  validator: &AsyncValidator[T], root: T, options: Validator.Options
) -> Validation.ValidationResult {
  validateAsyncWithData(validator, root, options, mapOf([])).await
}

/// Await selected rules with immutable application context data.
export async fn validateAsyncWithData[T](
  validator: &AsyncValidator[T], root: T, options: Validator.Options, data: Rule.ContextData
) -> Validation.ValidationResult {
  var failures: Array[Validation.Failure] = []
  for rule in validator.rules {
    if Validator.accepts(rule.name, &rule.ruleSets, &options) {
      let found = rule.run(root, options, data).await
      for failure in found { failures = failures.push(failure) }
      if validator.stop && !found.isEmpty() { break }
    }
  }
  Validation.fromFailures(failures)
}

/// Whether an indexed element is part of property selection.
fn selectedElement(name: Str, path: Str, properties: &Array[Str]) -> Bool {
  properties.isEmpty() || List.any(properties, |wanted: Str|
    wanted == name || wanted == path || wanted.startsWith(path + "."))
}
